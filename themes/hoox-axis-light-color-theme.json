{
  "$schema": "vscode://schemas/color-theme",
  "name": "HOOX AXIS Light",
  "type": "light",
  "semanticHighlighting": true,
  "colors": {
    "focusBorder": "#3d4fd4",
    "foreground": "#1a1d27",
    "descriptionForeground": "#5c6578",
    "errorForeground": "#c4384a",
    "icon.foreground": "#3a4154",
    "selection.background": "#3d4fd433",
    "widget.border": "#d5dbe8",
    "widget.shadow": "#1a1d2722",
    "textLink.foreground": "#3d4fd4",
    "textLink.activeForeground": "#2a379e",
    "textCodeBlock.background": "#eef1f8",
    "button.background": "#3d4fd4",
    "button.foreground": "#fbfbfe",
    "button.hoverBackground": "#2f3eb8",
    "button.secondaryBackground": "#e4e8f2",
