    "dropdown.foreground": "#1a1d27",
    "input.background": "#fbfbfe",
    "input.border": "#d5dbe8",
    "input.foreground": "#1a1d27",
    "input.placeholderForeground": "#8b93a7",
    "inputOption.activeBorder": "#3d4fd4",
    "inputOption.activeBackground": "#3d4fd422",
    "scrollbarSlider.background": "#3d4fd422",
    "scrollbarSlider.hoverBackground": "#3d4fd444",
    "scrollbarSlider.activeBackground": "#3d4fd466",
    "badge.background": "#3d4fd4",
    "badge.foreground": "#fbfbfe",
    "progressBar.background": "#3d4fd4",
    "list.activeSelectionBackground": "#3d4fd422",
    "list.activeSelectionForeground": "#1a1d27",
    "list.inactiveSelectionBackground": "#e4e8f2",
    "list.hoverBackground": "#eef1f8",
    "list.highlightForeground": "#3d4fd4",
    "list.errorForeground": "#c4384a",
    "list.warningForeground": "#9a6b10",
    "activityBar.background": "#f4f6fb",
    "activityBar.foreground": "#1a1d27",
    "activityBar.inactiveForeground": "#8b93a7",
    "activityBar.border": "#d5dbe8",
    "activityBarBadge.background": "#3d4fd4",
    "activityBarBadge.foreground": "#fbfbfe",
    "activityBar.activeBorder": "#3d4fd4",
    "sideBar.background": "#eef1f8",
    "sideBar.foreground": "#1a1d27",
    "sideBar.border": "#d5dbe8",
    "sideBarTitle.foreground": "#5c6578",
    "sideBarSectionHeader.background": "#eef1f8",
    "sideBarSectionHeader.foreground": "#5c6578",
    "sideBarSectionHeader.border": "#d5dbe8",
    "titleBar.activeBackground": "#f4f6fb",
    "titleBar.activeForeground": "#1a1d27",
    "titleBar.inactiveBackground": "#f4f6fb",
    "titleBar.inactiveForeground": "#8b93a7",
    "titleBar.border": "#d5dbe8",
    "menubar.selectionBackground": "#3d4fd422",
    "menu.background": "#fbfbfe",
    "menu.foreground": "#1a1d27",
    "menu.selectionBackground": "#3d4fd422",
    "menu.separatorBackground": "#d5dbe8",
    "editorGroup.border": "#d5dbe8",
    "editorGroupHeader.tabsBackground": "#f4f6fb",
    "editorGroupHeader.tabsBorder": "#d5dbe8",
    "tab.activeBackground": "#fbfbfe",
    "tab.activeForeground": "#1a1d27",
    "tab.inactiveBackground": "#f4f6fb",
    "tab.inactiveForeground": "#8b93a7",
    "tab.border": "#d5dbe8",
    "tab.activeBorderTop": "#3d4fd4",
    "tab.hoverBackground": "#eef1f8",
    "editor.background": "#fbfbfe",
    "editor.foreground": "#1a1d27",
    "editorCursor.foreground": "#3d4fd4",
    "editorLineNumber.foreground": "#a0a8ba",
    "editorLineNumber.activeForeground": "#3a4154",
    "editor.lineHighlightBackground": "#3d4fd40f",
    "editor.selectionBackground": "#3d4fd428",
    "editor.inactiveSelectionBackground": "#3d4fd414",
    "editor.wordHighlightBackground": "#3d4fd418",
    "editor.wordHighlightStrongBackground": "#0e749018",
    "editor.findMatchBackground": "#e8b84a55",
    "editor.findMatchHighlightBackground": "#e8b84a33",
    "editorBracketMatch.background": "#3d4fd418",
    "editorBracketMatch.border": "#3d4fd4",
    "editorIndentGuide.background1": "#e4e8f2",
    "editorIndentGuide.activeBackground1": "#c5cde0",
    "editorRuler.foreground": "#e4e8f2",
    "editorWhitespace.foreground": "#d5dbe8",
    "editorWidget.background": "#fbfbfe",
    "editorWidget.border": "#d5dbe8",
    "editorHoverWidget.background": "#fbfbfe",
    "editorHoverWidget.border": "#3d4fd455",
    "editorSuggestWidget.background": "#fbfbfe",
    "editorSuggestWidget.border": "#d5dbe8",
    "editorSuggestWidget.foreground": "#1a1d27",
    "editorSuggestWidget.selectedBackground": "#3d4fd422",
    "editorSuggestWidget.highlightForeground": "#3d4fd4",
    "editorGutter.background": "#fbfbfe",
    "editorGutter.addedBackground": "#0c7a52",
    "editorGutter.modifiedBackground": "#3d4fd4",
    "editorGutter.deletedBackground": "#c4384a",
    "editorError.foreground": "#c4384a",
    "editorWarning.foreground": "#9a6b10",
    "editorInfo.foreground": "#0e7490",
    "peekView.border": "#3d4fd4",
    "peekViewEditor.background": "#f4f6fb",
    "peekViewResult.background": "#fbfbfe",
    "peekViewTitle.background": "#eef1f8",
    "diffEditor.insertedTextBackground": "#0c7a5218",
    "diffEditor.removedTextBackground": "#c4384a18",
    "panel.background": "#f4f6fb",
    "panel.border": "#d5dbe8",
    "panelTitle.activeBorder": "#3d4fd4",
    "panelTitle.activeForeground": "#1a1d27",
    "panelTitle.inactiveForeground": "#8b93a7",
    "statusBar.background": "#eef1f8",
    "statusBar.foreground": "#3a4154",
    "statusBar.border": "#d5dbe8",
    "statusBar.debuggingBackground": "#3d4fd4",
    "statusBar.debuggingForeground": "#fbfbfe",
    "statusBar.noFolderBackground": "#eef1f8",
    "statusBarItem.remoteBackground": "#3d4fd4",
    "statusBarItem.remoteForeground": "#fbfbfe",
    "debugToolBar.background": "#fbfbfe",
    "debugToolBar.border": "#d5dbe8",
    "debugIcon.breakpointForeground": "#c4384a",
    "debugIcon.startForeground": "#0c7a52",
    "debugIcon.pauseForeground": "#9a6b10",
    "debugIcon.stopForeground": "#c4384a",
    "debugIcon.stepOverForeground": "#3d4fd4",
    "terminal.background": "#fbfbfe",
    "terminal.foreground": "#1a1d27",
    "terminal.ansiGreen": "#0c7a52",
    "terminal.ansiRed": "#c4384a",
    "terminal.ansiYellow": "#9a6b10",
    "terminal.ansiBlue": "#3d4fd4",
    "terminal.ansiCyan": "#0e7490",
    "terminal.ansiMagenta": "#6d4cc4",
    "charts.foreground": "#1a1d27",
    "charts.lines": "#d5dbe8",
    "charts.red": "#c4384a",
    "charts.blue": "#0e7490",
    "charts.yellow": "#9a6b10",
    "charts.orange": "#9a6b10",
    "charts.green": "#0c7a52",
    "charts.purple": "#6d4cc4",
    "gitDecoration.addedResourceForeground": "#0c7a52",
    "gitDecoration.modifiedResourceForeground": "#3d4fd4",
    "gitDecoration.deletedResourceForeground": "#c4384a",
    "gitDecoration.untrackedResourceForeground": "#0e7490",
    "toolbar.hoverBackground": "#e4e8f2"
  },
  "semanticTokenColors": {
    "comment": "#5c6578",
    "string": "#0c7a52",
    "number": "#9a6b10",
    "keyword": "#3d4fd4",
    "operator": "#5c6578",
    "function": "#0e7490",
    "method": "#3d4fd4",
    "variable": "#1a1d27",
    "parameter": "#9a4d28",
    "property": "#3a4154",
    "type": "#9a6b10",
    "class": "#9a6b10",
    "enum": "#6d4cc4",
    "namespace": "#3d4fd4",
    "macro": "#c4384a",
    "series": "#3d4fd4",
    "simple": "#6d4cc4",
    "*.series": "#3d4fd4",
    "*.simple": "#6d4cc4"
  },
  "tokenColors": [
    {
      "scope": ["comment", "comment.line.double-slash.pinescript", "comment.block.pinescript", "comment.line.number-sign.pinescript"],
      "settings": { "foreground": "#5c6578", "fontStyle": "italic" }
    },
    {
      "scope": ["string.quoted.double.pinescript", "string.quoted.single.pinescript", "string.quoted.triple.double.pinescript", "string.quoted.triple.single.pinescript", "string"],
      "settings": { "foreground": "#0c7a52" }
    },
    {
      "scope": ["constant.numeric.integer.pinescript", "constant.numeric.float.pinescript", "constant.numeric.hex.pinescript", "constant.numeric"],
      "settings": { "foreground": "#9a6b10" }
    },
    {
      "scope": ["constant.other.color.rgb-value.pinescript", "support.constant.color.pinescript"],
      "settings": { "foreground": "#a33d78" }
    },
    {
      "scope": ["constant.language.boolean.pinescript", "constant.language.na.pinescript"],
      "settings": { "foreground": "#c4384a" }
    },
    {
      "scope": ["keyword.control.conditional.pinescript", "keyword.control.flow.pinescript", "keyword.control.loop.pinescript", "keyword.control.import.pinescript", "keyword.control.export.pinescript", "keyword.control.as.pinescript", "keyword.control"],
      "settings": { "foreground": "#3d4fd4" }
    },
    {
      "scope": ["keyword.control.directive.pinescript", "keyword.other.annotation.pinescript", "meta.annotation.version.pinescript", "entity.name.tag.directive.pinescript", "string.unquoted.annotation.pinescript"],
      "settings": { "foreground": "#2a379e" }
    },
    {
      "scope": ["keyword.other.declaration.pinescript", "storage.type.pinescript", "storage.type.class.pinescript", "storage.type.enum.pinescript", "storage.type.qualifier.pinescript", "storage.modifier.pinescript"],
      "settings": { "foreground": "#9a6b10" }
    },
    {
      "scope": ["keyword.operator.arithmetic.pinescript", "keyword.operator.assignment.pinescript", "keyword.operator.assignment.compound.pinescript", "keyword.operator.assignment.reassign.pinescript", "keyword.operator.comparison.pinescript", "keyword.operator.logical.pinescript", "keyword.operator.bitwise.pinescript", "keyword.operator.ternary.pinescript", "keyword.operator.history-referencing.pinescript"],
      "settings": { "foreground": "#5c6578" }
    },
    {
      "scope": ["support.function.plot.pinescript", "support.function.drawing.pinescript"],
      "settings": { "foreground": "#3d4fd4" }
    },
    {
      "scope": ["support.function.builtin.pinescript", "entity.name.function.call.pinescript", "entity.name.function.pinescript", "support.function"],
      "settings": { "foreground": "#0e7490" }
    },
    {
      "scope": ["support.constant.strategy.pinescript", "support.module.pinescript", "entity.name.namespace.import.pinescript"],
      "settings": { "foreground": "#6d4cc4" }
    },
    {
      "scope": ["support.type.builtin.pinescript", "entity.name.type.pinescript", "entity.name.type.enum.pinescript", "storage.type"],
      "settings": { "foreground": "#9a6b10" }
    },
    {
      "scope": ["variable.language.series.pinescript", "variable.language.barstate.pinescript"],
      "settings": { "foreground": "#3d4fd4" }
    },
    {
      "scope": ["variable.other.pinescript", "variable.other.alias.pinescript", "variable"],
      "settings": { "foreground": "#1a1d27" }
    },
    {
      "scope": ["punctuation.accessor.dot.pinescript", "punctuation.separator.comma.pinescript", "punctuation.definition.parameters.begin.pinescript", "punctuation.section.parens.begin.pinescript", "punctuation.section.parens.end.pinescript", "punctuation.section.brackets.begin.pinescript", "punctuation.section.brackets.end.pinescript"],
      "settings": { "foreground": "#8b93a7" }
    }
  ]
}
