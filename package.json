{
  "name": "axis-ide",
  "displayName": "AXIS IDE",
  "description": "Lightweight AXIS chart in VS Code (custom editor *.axis.json) + Pyodide engine option. Core: chart editor + run orchestration for painting + secrets for Pro/CF worker. Depends on PYNE. Unofficial — not affiliated with TradingView, Inc.",
  "version": "0.3.1",
  "packageManager": "bun@1.4.4",
  "publisher": "hoox-sh",
  "license": "AGPL-3.0-only",
  "author": {
    "name": "jango_blockchained",
    "url": "https://hoox.sh"
  },
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#050505",
    "theme": "dark"
  },
  "homepage": "https://hoox.sh/axis",
  "qna": "https://github.com/hoox-sh/axis-ide-vsce/discussions",
  "repository": {
    "type": "git",
    "url": "https://github.com/hoox-sh/axis-ide-vsce.git"
  },
  "bugs": {
    "url": "https://github.com/hoox-sh/axis-ide-vsce/issues"
  },
  "engines": {
    "vscode": "^1.95.0"
  },
  "extensionKind": [
    "workspace"
  ],
  "extensionDependencies": [
    "hoox-sh.pyne"
  ],
  "categories": [
    "Other",
    "Visualization"
  ],
  "keywords": [
    "axis",
    "hoox",
    "pyne",
    "pinescript",
    "pine script",
    "charting",
    "pyodide",
    "vscode-extension"
  ],
  "activationEvents": [
    "onCustomEditor:axis.chart",
    "onCommand:axis.openChart",
    "onCommand:axis.runScript",
    "onCommand:axis.runScriptSilent",
    "onCommand:axis.secrets.setProKey",
    "onCommand:axis.secrets.setWorkerKey",
    "onCommand:axis.secrets.clear",
    "workspaceContains:**/*.axis.json"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "customEditors": [
      {
        "viewType": "axis.chart",
        "displayName": "AXIS Chart",
        "selector": [
          {
            "filenamePattern": "*.axis.json"
          }
        ],
        "priority": "default"
      }
    ],
    "commands": [
      {
        "command": "axis.openChart",
        "title": "Open Chart",
        "category": "AXIS",
        "icon": "$(graph)"
      },
      {
        "command": "axis.runScript",
        "title": "Run Script",
        "category": "AXIS",
        "icon": "$(play)"
      },
      {
        "command": "axis.runScriptSilent",
        "title": "Run Script (Silent)",
        "category": "AXIS"
      },
      {
        "command": "axis.secrets.setProKey",
        "title": "Set Pro API Key",
        "category": "AXIS"
      },
      {
        "command": "axis.secrets.setWorkerKey",
        "title": "Set Worker API Key (CF)",
        "category": "AXIS"
      },
      {
        "command": "axis.secrets.clear",
        "title": "Clear Stored Secrets",
        "category": "AXIS"
      }
    ],
    "keybindings": [
      {
        "command": "axis.runScript",
        "key": "ctrl+enter",
        "mac": "cmd+enter",
        "when": "editorTextFocus && editorLangId == pinescript"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "axis.openChart",
          "when": "resourceLangId == pinescript",
          "group": "navigation@1"
        },
        {
          "command": "axis.runScript",
          "when": "resourceLangId == pinescript",
          "group": "navigation@2"
        }
      ],
      "editor/context": [
        {
          "command": "axis.runScript",
          "when": "editorLangId == pinescript",
          "group": "axis@1"
        },
        {
          "command": "axis.openChart",
          "when": "editorLangId == pinescript",
          "group": "axis@2"
        }
      ],
      "explorer/context": [
        {
          "command": "axis.openChart",
          "when": "resourceLangId == pinescript",
          "group": "axis@1"
        },
        {
          "command": "axis.runScript",
          "when": "resourceLangId == pinescript",
          "group": "axis@2"
        }
      ],
      "commandPalette": [
        {
          "command": "axis.runScriptSilent",
          "when": "editorLangId == pinescript"
        }
      ]
    },
    "configuration": [
      {
        "title": "AXIS IDE",
        "properties": {
          "axis.telemetry.offline": {
            "type": "boolean",
            "default": true,
            "description": "Keep product telemetry off by default in IDE."
          },
          "axis.engine.endpoint": {
            "type": "string",
            "default": "http://127.0.0.1:5002",
            "markdownDescription": "PYNE Pro / engine base URL (no `/run` suffix). Defaults to loopback. Remote URLs require `#axis.engine.allowRemoteEndpoint#`."
          },
          "axis.engine.allowRemoteEndpoint": {
            "type": "boolean",
            "default": false,
            "scope": "application",
            "markdownDescription": "When false (default), `axis.engine.endpoint` must be loopback (`127.0.0.1` / `localhost` / `::1`) so the Pro Bearer key is not sent off-machine. **Application (user) scope only** — workspace settings cannot enable remote endpoints. Opt in only for trusted remote Pro hosts."
          },
          "axis.engine.allowPyodide": {
            "type": "boolean",
            "default": false,
            "description": "Allow the optional Pyodide calculator engine (webview assets; default off)."
          },
          "axis.chart.historyBars": {
            "type": "number",
            "default": 1500,
            "minimum": 50,
            "maximum": 20000,
            "markdownDescription": "Default OHLCV history window for new chart sessions and when the document omits a positive `historyBars`. Counts are clamped to **20000** (same as this maximum)."
          },
          "axis.chart.useMockBars": {
            "type": "boolean",
            "default": false,
            "markdownDescription": "When true, chart sessions and runs use deterministic mock/fixture bars (opt-in). Default **false** fetches real OHLCV from `axis.datafeed.url` (local axis-datafeed sidecar, default `http://127.0.0.1:5003`)."
          },
          "axis.datafeed.url": {
            "type": "string",
            "default": "http://127.0.0.1:5003",
            "markdownDescription": "Base URL for the local `@hoox-sh/axis-datafeed` sidecar (`GET /datafeed/ohlcv`). Defaults to loopback `:5003`. Remote URLs require `#axis.engine.allowRemoteEndpoint#`."
          }
        }
      }
    ]
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "vscode:prepublish": "npm run compile",
    "compile:webview:chart": "vite build --config webview/chart/vite.config.ts",
    "compile:webview": "npm run compile:webview:chart",
    "compile": "node esbuild.host.mjs && npm run compile:webview",
    "check": "tsc -p ./ --noEmit && tsc -p webview/chart/tsconfig.json --noEmit",
    "watch": "node esbuild.host.mjs --watch",
    "watch:webview": "vite build --config webview/chart/vite.config.ts --watch",
    "compile-tests": "tsc -p tsconfig.tests.json",
    "package": "node -e \"const v=require('./package.json').version; require('child_process').execSync('npx --yes @vscode/vsce package --no-dependencies --no-git-tag-version --out axis-ide-'+v+'.vsix',{stdio:'inherit'})\"",
    "test:unit": "bun test --isolate",
    "test:coverage": "bun test --isolate --coverage --coverage-reporter=lcov --coverage-reporter=text --coverage-dir=coverage",
    "test:coverage:gate": "bun run test:coverage && bun scripts/check-coverage.mjs",
    "test": "npm run compile-tests && npm run compile && node out/test/runTest.js",
    "pack:package": "bun run --cwd pack package",
    "pack:ls": "bun run --cwd pack ls",
    "lint": "biome check .",
    "lint:fix": "biome check --write --unsafe ."
  },
  "dependencies": {
    "lightweight-charts": "^5.2.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.13.10",
    "@types/vscode": "^1.95.0",
    "@vscode/test-electron": "^2.4.1",
    "@vscode/vsce": "^3.3.2",
    "esbuild": "^0.25.1",
    "mocha": "^11.1.0",
    "typescript": "^5.8.2",
    "vite": "^6.2.0"
  }
}
