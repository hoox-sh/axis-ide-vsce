# Ignore everything by default, then allowlist runtime artifacts.
# node_modules is excluded — lightweight-charts is Vite-bundled into dist/webview/chart/main.js only.
.vscode/**
.vscode-test/**
src/**
webview/**
node_modules/**
.git/**
.gitignore
**/*.ts
**/*.tsx
**/*.map
*.map
tsconfig.json
tsconfig.tests.json
esbuild.host.mjs
.vscodeignore
package-lock.json
bun.lock
bunfig.toml
**/*.vsix
**/*.md
!README.md
# Package root legal files (NOTICE has no extension; keep explicit).
!NOTICE
!LICENSE
**/.DS_Store
test-fixtures/**
fixtures/**
coverage/**
scripts/**

# Host bundle (esbuild) — only the entry, not other out/ leftovers.
out/**
!out/extension.js

# Chart + results webview runtime — nested whitelist (gitignore style) so only
# main.js/css ship. Do not un-ignore the directories wholesale (that pulls in *.map).
dist/**
!dist/webview/
dist/webview/**
!dist/webview/chart/
dist/webview/chart/**
!dist/webview/chart/main.js
!dist/webview/chart/main.css
!dist/webview/runoutput/
dist/webview/runoutput/**
!dist/webview/runoutput/main.js
!dist/webview/runoutput/main.css
!dist/webview/toolbox/
dist/webview/toolbox/**
!dist/webview/toolbox/main.js
!dist/webview/toolbox/main.css
!dist/webview/plugins/
dist/webview/plugins/**
!dist/webview/plugins/main.js
!dist/webview/plugins/main.css
!dist/webview/library/
dist/webview/library/**
!dist/webview/library/main.js
!dist/webview/library/main.css
!dist/webview/layers/
dist/webview/layers/**
!dist/webview/layers/main.js
!dist/webview/layers/main.css
!dist/webview/scripts/
dist/webview/scripts/**
!dist/webview/scripts/main.js
!dist/webview/scripts/main.css
!dist/webview/watchlist/
dist/webview/watchlist/**
!dist/webview/watchlist/main.js
!dist/webview/watchlist/main.css
!dist/webview/alerts/
dist/webview/alerts/**
!dist/webview/alerts/main.js
!dist/webview/alerts/main.css
!dist/webview/workers/
dist/webview/workers/**
!dist/webview/workers/main.js
!dist/webview/workers/main.css


# Repo-only (standalone layout) — never ship these in the extension VSIX.
.github/**
pack/**
docs/**
biome.json
.editorconfig
.gitattributes
AGENTS.md
DESIGN.md
CHANGELOG.md
CONTRIBUTING.md
CODE_OF_CONDUCT.md
SECURITY.md
PUBLISH.md
opencode.json
okf/
*-contributes.fragment.json
*.fragment.md
