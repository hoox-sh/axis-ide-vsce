# Ignore everything by default, then allowlist runtime artifacts.
# node_modules is excluded — lightweight-charts is Vite-bundled into dist/webview/chart/main.js only.
.vscode/**
.vscode-test/**
src/**
webview/**
node_modules/**
.git/**
.gitignore
**/*.ts
**/*.tsx
**/*.map
*.map
tsconfig.json
tsconfig.tests.json
esbuild.host.mjs
.vscodeignore
package-lock.json
bun.lock
bunfig.toml
**/*.vsix
**/*.md
!README.md
# Package root legal files (NOTICE has no extension; keep explicit).
!NOTICE
!LICENSE
**/.DS_Store
.pytest_cache/**
test-fixtures/**
# Ship walkthrough fixtures (not test-fixtures).
!fixtures/
!fixtures/**
!media/walkthrough-first-plot.md
!media/pyodide/
!media/pyodide/**
coverage/**
scripts/**

# Host bundle (esbuild) — only the entry, not other out/ leftovers.
out/**
!out/extension.js

# Chart webview runtime only (lightweight core). Nested whitelist so only main.js/css ship.
dist/**
!dist/webview/
dist/webview/**
!dist/webview/chart/
dist/webview/chart/**
!dist/webview/chart/main.js
!dist/webview/chart/main.css


# Repo-only (standalone layout) — never ship these in the extension VSIX.
.github/**
pack/**
docs/**
biome.json
.editorconfig
.gitattributes
AGENTS.md
DESIGN.md
CHANGELOG.md
CONTRIBUTING.md
CODE_OF_CONDUCT.md
SECURITY.md
PUBLISH.md
opencode.json
okf/
*-contributes.fragment.json
*.fragment.md

# Dev / AI / orchestration artifacts (build-time or repo-only; never in VSIX or installed extension)
.openorchestrate/**
.githooks/**
.ooignore
llms.txt
.grok/**
.opencode/**
.tmp/**
