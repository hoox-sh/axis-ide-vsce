#!/bin/sh
# AXIS IDE pre-commit gate: Biome on staged source files.
# Skip with `git commit --no-verify` when you really mean it.
# (The OKF enrich step was removed with the OKF bundle in the lightweight core.)

cd "$(git rev-parse --show-toplevel)" || exit 1

files=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '\.(js|jsx|ts|tsx|json|jsonc|css)$' | grep -vE '^(fixtures|media|pack)/' || true)
if [ -n "$files" ]; then
  echo "Running biome check on staged files…"
  # shellcheck disable=SC2086
  printf '%s\0' $files | xargs -0 -r bunx biome check --no-errors-on-unmatched -- 2>&1
  if [ $? -ne 0 ]; then
    echo "❌ Biome check failed on staged files. Fix them (bunx biome check --write <file>) or commit with --no-verify."
    exit 1
  fi
  echo "✓ Biome check passed."
fi
